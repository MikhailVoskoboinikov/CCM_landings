---
/* Живые версии иконок Lucide (ISC): те же контуры, части двигаются при наведении на карточку. */
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
---
<svg class="audience-motion" xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "Stethoscope" && <>
    <path d="M11 2v2 M5 2v2 M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" />
    <path class="stethoscope-tube" d="M8 15 C8 18.3 10.7 21 14 21 C17.3 21 20 18.3 20 15 L20 12" />
    <g class="membrane">
      <circle cx="20" cy="10" r="2" />
    </g>
  </>}
  {name === "BriefcaseBusiness" && <>
    <path d="M2 13v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5" />
    <g class="case-lid">
      <path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2 M2 13V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a18.15 18.15 0 0 1-20 0 M12 12h.01" />
    </g>
  </>}
  {name === "Plane" && <g class="plane-body">
    <g class="flight-trails" opacity="0">
      <path d="m3.4 7.2-6 6" /><path d="m17.3 20.4-6 6" />
    </g>
    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
  </g>}
  {name === "HeartHandshake" && <>
    <path class="handshake" d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762" />
  </>}
  {name === "Globe" && <>
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18" />
    <svg x="3" y="3" width="18" height="18" viewBox="-9 -9 18 18" overflow="hidden" style="clip-path:circle(50% at 50% 50%);">
      <g class="globe-lines">
        <ellipse cx="-24" cy="0" rx="4" ry="9" /><ellipse cx="-12" cy="0" rx="4" ry="9" />
        <ellipse cx="0" cy="0" rx="4" ry="9" /><ellipse cx="12" cy="0" rx="4" ry="9" /><ellipse cx="24" cy="0" rx="4" ry="9" />
      </g>
    </svg>
  </>}
  {name === "GraduationCap" && <g class="graduation-cap">
    <path d="m2 9 10-5 10 5-10 5-10-5Z M6 11v6c3 3 9 3 12 0v-6 M22 9v7" />
  </g>}
</svg>

<style>
  .audience-motion { overflow: visible; transition: color .2s ease, filter .2s ease, transform .2s ease; }
  .flight-trails { stroke-width: 1.4; stroke-dasharray: 8.49; stroke-dashoffset: 8.49; }
  .case-lid { transform-origin: 2px 13px; }
  .handshake { transform-origin: 12px 14px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.audience-card:hover) .audience-motion { color: #ed1725; filter: drop-shadow(0 0 3px rgb(237 23 37 / 18%)); transform: scale(1.08); }
    :global(.audience-card:hover) .stethoscope-tube { animation: tube-bend 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .membrane { animation: membrane-circle 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .case-lid { animation: case-open 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .flight-trails { animation: flight-lines 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .plane-body { animation: plane-flight 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .globe-lines { animation: globe-spin 2.4s linear infinite; }
    :global(.audience-card:hover) .graduation-cap { animation: cap-toss 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .handshake { animation: hands-shake 2.4s ease-in-out infinite; }
  }
  @keyframes membrane-circle {
    0%, 80%, 100% { transform: translate(0, 0); }
    15% { transform: translate(-1.8px, -1.4px); }
    30% { transform: translate(.8px, -2px); }
    45% { transform: translate(2px, .8px); }
    60% { transform: translate(-.8px, 1.7px); }
  }
  @keyframes tube-bend {
    0%, 80%, 100% {
      d: path("M8 15 C8 18.3 10.7 21 14 21 C17.3 21 20 18.3 20 15 L20 12");
    }
    15% {
      d: path("M8 15 C8 18.3 10.4 21 13.3 20.7 C16.4 20.4 18.2 17.4 18.2 13.6 L18.2 10.6");
    }
    30% {
      d: path("M8 15 C8 18.3 11.1 21 14.8 20.7 C18.4 20.4 20.8 17 20.8 13 L20.8 10");
    }
    45% {
      d: path("M8 15 C8 18.3 11.4 21.4 15.1 21.4 C18.9 21.4 22 19.5 22 15.8 L22 12.8");
    }
    60% {
      d: path("M8 15 C8 18.3 10.3 22 13.6 22 C17 22 19.2 20 19.2 16.7 L19.2 13.7");
    }
  }
  @keyframes case-open {
    0%, 80%, 100% { transform: rotate(0deg); }
    20%, 40% { transform: rotate(-13deg); }
    55% { transform: rotate(-9deg); }
    65% { transform: rotate(-12deg); }
  }
  @keyframes flight-lines {
    0%, 40%, 80%, 100% { opacity: 0; stroke-dashoffset: 8.49; }
    5%, 45% { opacity: 1; stroke-dashoffset: 8.49; }
    25%, 65% { opacity: 1; stroke-dashoffset: 0; }
    35%, 75% { opacity: 0; stroke-dashoffset: 0; }
  }
  @keyframes plane-flight {
    0%, 80%, 100% { transform: translate(0, 0); }
    25% { transform: translate(1.4px, -1.4px); }
    45% { transform: translate(.5px, -.5px); }
    60% { transform: translate(1.2px, -1.2px); }
  }
  @keyframes hands-shake {
    0%, 80%, 100% { transform: scale(1); }
    18% { transform: scale(.9, 1.03); }
    35% { transform: scale(1.02, .98); }
    52% { transform: scale(.92, 1.03); }
    68% { transform: scale(1); }
  }
  @keyframes globe-spin {
    from { transform: translateX(0); }
    to { transform: translateX(-12px); }
  }
  @keyframes cap-toss {
    0%, 70%, 100% { transform: translateY(0); }
    25% { transform: translateY(-3px); }
    45% { transform: translateY(.6px); }
    55% { transform: translateY(-.8px); }
  }
</style>
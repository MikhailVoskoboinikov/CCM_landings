---
import Icon from "./Icon.astro";
import Rich from "./Rich.astro";
import HeaderMessengerIcon from "./HeaderMessengerIcon.astro";
import { MESSENGER_LABEL, type Country } from "@/data";
interface Props { country: Country }
const { country } = Astro.props;
const chats = country.messengers.filter((m) => m.id !== "instagram");
---
<div class="rounded-3xl border border-line bg-soft p-6 lg:p-7">
  <div class="flex items-center gap-3">
    <span class="grid size-6 shrink-0 place-items-center text-brand" aria-hidden="true"><Icon name="MessageCircle" size={23} /></span>
    <h3 class="text-xl font-bold leading-snug">Остались вопросы?</h3>
  </div>
  <p class="mt-3 text-[15px] leading-relaxed text-ink-2">Поможем разобраться в программе курса и выбрать удобную дату.</p>
  <div class="mt-6">
    <a href={country.phoneHref} class="inline-block whitespace-nowrap text-xl font-bold tracking-tight text-ink transition-colors hover:text-brand">{country.phone}</a>
    <Rich as="p" class="mt-2 text-[13px] leading-relaxed text-ink-2" text="[[пн–сб, 9:00–19:00|Подтвердить часы работы менеджеров учебного центра Ташкента и часовой пояс]]" />
  </div>
  <div class="mt-6 border-t border-line pt-5">
    <p class="mb-3 text-xs font-medium text-ink-2">Или напишите нам</p>
    <div class="flex flex-wrap gap-2">
      {chats.map((m) => (
        <a href={m.href} aria-label={`Связаться в ${MESSENGER_LABEL[m.id]}`} class="flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border border-line bg-white px-3 py-2.5 text-[13px] font-semibold text-ink transition-colors hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
          <span class="shrink-0"><HeaderMessengerIcon id={m.id} /></span>
          {MESSENGER_LABEL[m.id]}
        </a>
      ))}
    </div>
  </div>
</div>
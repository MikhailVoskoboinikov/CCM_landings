<figure class="mx-auto w-full max-w-[540px]">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300" class="block w-full rounded-3xl bg-white" role="img" aria-label="Учебные центры ЦКМ: Томск, Москва, Санкт-Петербург, Астана, Бишкек и Ташкент">
    <rect width="600" height="300" fill="#fff" />
    <path d={land} fill="#eceef1" stroke="#fff" stroke-width="1" />
    {links.map(([from, to]) => {
      const [x1, y1] = points[from].point;
      const [x2, y2] = points[to].point;
      const lift = Math.max(18, Math.hypot(x2 - x1, y2 - y1) * .24);
      return <path d={`M${x1} ${y1} Q${(x1 + x2) / 2} ${Math.min(y1, y2) - lift} ${x2} ${y2}`} fill="none" stroke="var(--brand)" stroke-opacity=".32" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2 5" />;
    })}
    {points.map((center) => (
      <g transform={`translate(${center.point[0]},${center.point[1]})`}>
        <circle r={center.country === country.id ? 11 : 8} fill="var(--brand)" fill-opacity=".1" />
        <circle r={center.country === country.id ? 5.5 : 4.5} fill="var(--brand)" stroke="white" stroke-width="2" />
        <text x={center.label.x} y={center.label.y} text-anchor={center.label.anchor} font-size="13" font-weight="600" fill="#4a4f57" stroke="white" stroke-width="4" paint-order="stroke" stroke-linejoin="round">{center.city}</text>
      </g>
    ))}
  </svg>
</figure>
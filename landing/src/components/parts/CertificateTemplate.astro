---
/* Незаполненная SVG-основа по предоставленному образцу: с предоставленным логотипом ERC и декоративной подписью, без личных данных. */
interface Props { hotspots?: boolean }
const { hotspots = false } = Astro.props;
const spots = [
  { n: 1, x: 86, y: 24, label: "Имя участника" },
  { n: 2, x: 75, y: 43, label: "Квалификация BLS Provider" },
  { n: 3, x: 65, y: 84, label: "Даты обучения и повторной сертификации" },
  { n: 4, x: 74, y: 96, label: "Проверка подлинности" },
];
---
<div class="certificate-template relative @container">
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 698 493"
  role="img"
  aria-label="Незаполненный образец сертификата Basic Life Support на английском языке"
  class="block h-auto w-full select-none rounded-[6px] bg-white shadow-[0_30px_60px_-20px_rgba(17,19,23,.35)] ring-1 ring-black/5"
>
  <rect width="698" height="493" fill="#fff" />
  <rect width="24" height="298" fill="#00799b" />
  <rect x="673" y="299" width="25" height="194" fill="#ed1725" />
  <image x="42" y="18" width="166" height="74" href="data:image/png;base64," />
  <g fill="#00799b" font-family="Arial, Helvetica, sans-serif" text-anchor="middle">
    <text x="349" y="51" font-size="11" letter-spacing="2">CERTIFICATE</text>
    <text x="349" y="180" font-size="16">Received the ERC qualification</text>
    <text x="349" y="212" font-size="26">Basic Life Support (BLS)</text>
    <text x="349" y="243" font-size="26">Provider</text>
    <text x="349" y="327" font-size="12">lead instructor</text>
    <text x="310" y="410" font-size="9" text-anchor="end">Date of last course:</text>
    <text x="310" y="427" font-size="9" text-anchor="end">Deadline for ERC recertification:</text>
    <text x="349" y="451" font-size="9">The holder of this certificate is responsible for the periodical update</text>
    <text x="349" y="464" font-size="9">of their knowledge, skills and retraining.</text>
    <text x="349" y="478" font-size="9">Verify this certificate at cosy.erc.edu/en/verify-certificate</text>
    <text x="596" y="42" font-size="8" letter-spacing="1" fill="#8b9da4">SAMPLE</text>
  </g>
  <g fill="none" stroke="#00799b" stroke-opacity=".18">
    <path d="M125 122H573 M300 147H398 M287 267H411 M320 410H428 M320 427H428" />
  </g>
  <!-- Декоративный росчерк: не воспроизводит подпись конкретного человека. -->
  <path d="M288 305 C297 295 304 282 305 277 C307 268 299 278 298 291 C297 302 304 308 312 297 C320 285 320 294 316 303 C323 299 328 286 331 288 C335 291 325 305 332 303 L344 291 C347 288 342 301 347 302 C354 303 359 290 361 292 C364 295 356 300 363 302 C373 305 385 290 390 293 C394 296 386 302 393 301 L409 294 M300 310 C333 305 374 307 411 306" fill="none" stroke="#00799b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
{hotspots && spots.map((spot) => (
  <button type="button" data-spot={spot.n} class="cert-spot" style={`left:${spot.x}%;top:${spot.y}%`} aria-label={`${spot.n}. ${spot.label}`} title={spot.label}>{spot.n}</button>
))}
</div>
<style>
  .cert-spot {
    position: absolute;
    translate: -50% -50%;
    width: clamp(22px, 4.5cqi, 30px);
    height: clamp(22px, 4.5cqi, 30px);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brand);
    color: white;
    font: 700 clamp(12px, 2.2cqi, 15px)/1 var(--font-sans);
    box-shadow: 0 2px 10px rgb(17 19 23 / 20%);
    cursor: pointer;
    transition: transform .2s ease;
  }
  .cert-spot:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }
</style>
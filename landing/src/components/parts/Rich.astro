---
/* Текст с пометками «уточнить у ЦКМ» и **выделением**, см. lib/rich.ts. Прочие атрибуты передаются тегу */
import { rich } from "@/lib/rich";
interface Props { text: string; as?: string; class?: string; [attr: string]: unknown }
const { text, as: Tag = "span", class: cls, ...rest } = Astro.props;
---
<Tag class={cls} {...rest} set:html={rich(text)} />

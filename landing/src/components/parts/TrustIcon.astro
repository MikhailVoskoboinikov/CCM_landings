---
import Icon from "./Icon.astro";
interface Props { name: string; size?: number }
const { name, size = 22 } = Astro.props;
---
{name === "Stethoscope" ? <Icon name={name} size={size} animated /> : (
  <svg class="trust-motion" xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === "BadgeCheck" && <>
      <path d="m12 2 3 1.8 3.5.5.7 3.4 2 2.8-1.4 3.2-.2 3.5-3.4 1-2.7 2.3-3.3-1-3.5.2-1.3-3.3-2.5-2.5.7-3.4-.5-3.5L6.2 6 8.5 3.3Z" />
      <path class="trust-check" d="m8 12 2.5 2.5L16 9" pathLength="1" />
    </>}
        {name === "Ambulance" && <>
      <g class="ambulance-trails" opacity="0"><path d="M1 8h-6 M1 12h-8 M1 16h-5" /></g>
      <g class="ambulance-drive"><Icon name="Ambulance" size={24} strokeWidth={1.8} /></g>
    </>}
    {name === "HeartPulse" && <>
      <path class="practice-heart" d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />

      <path class="practice-ecg" d="M3 12h4l2-3 3 7 2-6 2 2h5" pathLength="1" />
    </>}
  </svg>
)}
<style>
  .trust-motion { overflow: visible; transition: color .2s ease, filter .2s ease, transform .2s ease; }
  .ambulance-trails { stroke-dasharray: 8; stroke-dashoffset: 8; stroke-width: 1.4; }
  .practice-heart { transform-origin: 12px 12px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.audience-card:hover) .trust-motion { color: #ed1725; filter: drop-shadow(0 0 3px rgb(237 23 37 / 18%)); transform: scale(1.08); }
    :global(.audience-card:hover) .trust-check { animation: trust-check-draw 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .ambulance-trails { animation: ambulance-trails 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .ambulance-drive { animation: ambulance-drive 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .practice-heart { animation: practice-pulse 2.4s ease-in-out infinite; }
    :global(.audience-card:hover) .practice-ecg { stroke-dasharray: .65 .35; animation: practice-signal 1.2s linear infinite; }
  }
  @keyframes trust-check-draw {
    0%, 10% { stroke-dasharray: 1; stroke-dashoffset: 1; }
    40%, 80% { stroke-dasharray: 1; stroke-dashoffset: 0; }
    100% { stroke-dasharray: 1; stroke-dashoffset: 1; }
  }
  @keyframes ambulance-drive {
    0%, 85%, 100% { transform: translate(0, 0); }
    15% { transform: translateY(-.8px); }
    30% { transform: translateY(.6px); }
    45% { transform: translateY(-.8px); }
    60% { transform: translateY(.6px); }
    70% { transform: translateY(-.4px); }
  }
  @keyframes ambulance-trails {
    0%, 40%, 80%, 100% { opacity: 0; stroke-dashoffset: 8; }
    5%, 45% { opacity: 1; stroke-dashoffset: 8; }
    25%, 65% { opacity: 1; stroke-dashoffset: 0; }
    35%, 75% { opacity: 0; stroke-dashoffset: 0; }
  }
  @keyframes practice-pulse {
    0%, 40%, 80%, 100% { transform: scale(1); }
    15%, 55% { transform: scale(1.08); }
    25%, 65% { transform: scale(.97); }
  }
  @keyframes practice-signal { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>

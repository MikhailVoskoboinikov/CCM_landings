---
/*
 * Одна сцена ролика — анимированный SVG 400 × 300. Анимации запускаются, только
 * когда сцена активна (.film-scene[data-on] в Film.astro), и перезапускаются при показе.
 * Стиль: плоские фигуры без контуров. Спасатель в красном, пострадавший в сером.
 * Темп компрессий — настоящий: 110 в минуту (0,545 с на нажатие).
 */
import type { FilmKind } from "@/data";
import KidsMotion from "./KidsMotion.astro";
import kidsCoughIllustration from "@/assets/film-kids-cough.svg?url";
import kidsBackBlowsIllustration from "@/assets/film-kids-back-blows.svg?url";
import kidsAbdominalThrustsIllustration from "@/assets/film-kids-abdominal-thrusts.svg?url";
import kidsCallIllustration from "@/assets/film-kids-emergency-call.svg?url";
import kidsResuscitationIllustration from "@/assets/film-kids-resuscitation.svg?url";
import kidsTrainingIllustration from "@/assets/film-kids-training.svg?url";
import bleedingBandageIllustration from "@/assets/film-bleeding-bandage.svg?url";
import bleedingTourniquetIllustration from "@/assets/film-bleeding-tourniquet.svg?url";
import bleedingTrainingIllustration from "@/assets/film-bleeding-training.svg?url";
import pressureIllustration from "@/assets/film-bleeding-pressure.svg?url";
import responseIllustration from "@/assets/film-bls-response.svg?url";
import breathingIllustration from "@/assets/film-bls-breath-check.svg?url";
import safetyIllustration from "@/assets/film-safety.svg?url";
import callIllustration from "@/assets/film-emergency-call.svg?url";
import compressionIllustration from "@/assets/film-bls-compressions.svg?url";
import rescueBreathsIllustration from "@/assets/film-bls-rescue-breaths.svg?url";
import aedIllustration from "@/assets/film-bls-aed.svg?url";
import blsTrainingIllustration from "@/assets/film-bls-training.svg?url";

interface Props { kind: FilmKind; count?: string; bleeding?: boolean; kids?: boolean }
const { kind, count, bleeding = false, kids = false } = Astro.props;
const kidsIllustrations: Partial<Record<FilmKind, string>> = {
  cough: kidsCoughIllustration,
  backblows: kidsBackBlowsIllustration,
  abdominal: kidsAbdominalThrustsIllustration,
  call: kidsCallIllustration,
  compress: kidsResuscitationIllustration,
  course: kidsTrainingIllustration,
};
const kidsIllustration = kids ? kidsIllustrations[kind] : undefined;
const C = { skin: "#f1c3a0", skin2: "#e2a57f", hair: "#2b2b31", victim: "#c9ced6", pants: "#4a4f57", res: "#d9262c", resDark: "#b51f25", ink: "#111317", floor: "#e6e8ec", sun: "#ffb81c", white: "#fff" };
const kidCount = count === "15 : 2" ? 15 : 30;
---
<svg viewBox="0 0 400 300" class="size-full" aria-hidden="true">
  <rect width="400" height="300" fill="#f4f5f7" />
  <circle cx="200" cy="150" r="128" fill="#fff" />

  {kidsIllustration ? (<>
    <image href={kidsIllustration} x="16" y="20" width="368" height="260" preserveAspectRatio="xMidYMid meet" />
    <KidsMotion kind={kind} />
  </>) : (<>

  {kind === "safety" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={safetyIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(300 90)">
        <circle r="33" fill="#fff" stroke={C.floor} stroke-width="5" />
        <circle r="33" fill="none" stroke={C.res} stroke-width="5" stroke-linecap="round" pathLength="1" stroke-dasharray=".18 .82" class="f-eye-scan" />
        <path d="M-20 0C-9-17 9-17 20 0C9 17-9 17-20 0Z" fill="none" stroke={C.ink} stroke-width="2.5" />
        <circle class="f-eye-look" r="7" fill={C.ink} /><circle cx="2" cy="-2" r="2" fill="#fff" />
      </g>
      <g class="f-pop" style="--d:.5s">
        <path d="M281 174 300 139 319 174Q321 179 316 179H284Q279 179 281 174Z" fill={C.sun} />
        <path d="M300 151v12" stroke={C.ink} stroke-width="3" stroke-linecap="round" />
        <circle cx="300" cy="170" r="1.8" fill={C.ink} />
      </g>
    </>
  )}
  {kind === "shake" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={responseIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g class="f-speech-pop" style="--d:.45s">
      <rect x="208" y="54" width="173" height="49" rx="15" fill={C.ink} />
      <path d="m220 101-8 16 25-15Z" fill={C.ink} />
      <text x="294.5" y="84" text-anchor="middle" fill="#fff" font-size="15.5" font-weight="700" font-family="var(--font-sans)">Вы меня слышите?</text>
      </g>
    </>
  )}
  {kind === "breath-check" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={breathingIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(300 110)">
        <circle r="42" fill="none" stroke={C.floor} stroke-width="8" />
        <g transform="rotate(-90)"><circle r="42" fill="none" stroke={C.res} stroke-width="8" stroke-linecap="round" pathLength="100" stroke-dasharray="100" class="f-timer" /></g>
        <text y="8" text-anchor="middle" font-size="24" font-weight="800" fill={C.ink} font-family="var(--font-sans)">10 с</text>
      </g>
    </>
  )}
  {kind === "call" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={callIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(294 138)">
        <rect class="f-call-pulse" x="-43" y="-20" width="86" height="40" rx="20" fill="none" stroke={C.res} stroke-width="2" />
        <rect x="-40" y="-17" width="80" height="34" rx="17" fill="#fff" stroke={C.floor} stroke-width="1.5" />
        <path d="M-21-7c-2 0-4 2-3 5 2 6 6 10 12 12 3 1 5-1 5-3l-5-3-2 2c-3-1-5-3-6-6l2-2Z" fill={C.res} />
        <text x="11" y="7" text-anchor="middle" font-size="20" font-weight="800" fill={C.ink} font-family="var(--font-sans)">103</text>
      </g>
      {!bleeding && (<g class="f-speech-right" style="--d:.8s">
        <rect x="208" y="48" width="173" height="48" rx="16" fill={C.ink} />
        <path d="M211 66 164 84 211 84Z" fill={C.ink} />
        <text x="294.5" y="78" text-anchor="middle" fill="#fff" font-size="18" font-weight="700" font-family="var(--font-sans)">Нужен АНД!</text>
      </g>)}
    </>
  )}
  {kind === "compress" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={compressionIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(300 80)">
        <rect x="-50" y="-26" width="100" height="58" rx="16" fill={C.ink} />
        <text data-count data-to={kidCount} data-every="545" y="8" text-anchor="middle" font-size="30" font-weight="800" fill="#fff" font-family="var(--font-sans)">0</text>
        <text y="24" text-anchor="middle" font-size="11" fill="#fff" opacity=".7" font-family="var(--font-sans)">{count ?? "из 30"}</text>
      </g>
      <g transform="translate(300 137)">
        <circle r="17" fill={C.res} opacity=".08" />
        <g class="f-compression-beat">
          <circle r="12" fill={C.res} />
          <path d="M0-5v9 M-4 0l4 4 4-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
    </>
  )}
  {kind === "breaths" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={rescueBreathsIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(300 90)">
        <rect x="-44" y="-24" width="88" height="48" rx="16" fill={C.ink} />
        <text y="9" text-anchor="middle" font-size="24" font-weight="800" fill="#fff" font-family="var(--font-sans)">× 2</text>
      </g>
      <g transform="translate(300 145)">
        <g class="f-rescue-air">
          <path d="M-19-5H8c9 0 9-12 1-12 M-22 3h38c8 0 8 11 1 11 M-15 11H1" fill="none" stroke={C.res} stroke-width="2.5" stroke-linecap="round" />
        </g>
      </g>
    </>
  )}
  {kind === "aed" && (
    <>
      <rect x="32" y="237" width="336" height="5" rx="2.5" fill={C.floor} />
      <image href={aedIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g transform="translate(300 80)">
        <rect x="-44" y="-24" width="88" height="48" rx="16" fill={C.ink} />
        <text y="8" text-anchor="middle" font-size="23" font-weight="800" fill="#fff" font-family="var(--font-sans)">АНД</text>
      </g>
      <g transform="translate(254 176)">
        <circle class="f-aed-light" r="4" fill="none" stroke={C.res} stroke-width="1.5" />
      </g>
    </>
  )}
  {/* Рука с раной для кровотечения */}
  {!bleeding && ["bandage", "tourniquet"].includes(kind) && (
    <>
      <rect x="40" y="168" width="300" height="48" rx="24" fill={C.skin} />
      <rect x="320" y="160" width="46" height="64" rx="22" fill={C.skin} />
      <rect x="20" y="160" width="60" height="64" rx="18" fill={C.victim} />
    </>
  )}

  {kind === "press" && (
    <image href={pressureIllustration} x="16" y="20" width="368" height="260" preserveAspectRatio="xMidYMid meet" />
  )}

  {kind === "bandage" && (bleeding ? (
    <image href={bleedingBandageIllustration} x="16" y="20" width="368" height="260" preserveAspectRatio="xMidYMid meet" />
  ) : (
    <>
      <rect x="182" y="172" width="58" height="40" rx="6" fill="#fff" />
      {[0, 1, 2, 3, 4].map((k) => (
        <g class="f-pop" style={`--d:${0.6 + k * 0.45}s`}>
          <rect x={172 + k * 16} y="162" width="14" height="60" rx="5" fill="#fff" stroke={C.floor} stroke-width="2" transform={`rotate(-12 ${179 + k * 16} 192)`} />
        </g>
      ))}
    </>
  ))}

  {kind === "tourniquet" && (bleeding ? (
    <image href={bleedingTourniquetIllustration} x="16" y="20" width="368" height="260" preserveAspectRatio="xMidYMid meet" />
  ) : (
    <>
      <ellipse cx="250" cy="192" rx="20" ry="11" fill={C.res} opacity=".85" />
      <g class="f-tighten"><rect x="150" y="160" width="20" height="64" rx="6" fill={C.ink} /><rect x="142" y="186" width="36" height="12" rx="4" fill={C.sun} /></g>
      <g class="f-pop" style="--d:2.4s">
        <rect x="112" y="72" width="104" height="48" rx="14" fill={C.ink} />
        <text x="164" y="104" text-anchor="middle" font-size="22" font-weight="800" fill="#fff" font-family="var(--font-sans)">14:32</text>
        <path d="M150 118 l8 16 8-16Z" fill={C.ink} />
      </g>
    </>
  ))}

  {/* Ребёнок стоит, взрослый рядом */}
  {["cough", "backblows", "abdominal"].includes(kind) && (
    <>
      <rect x="40" y="236" width="320" height="6" rx="3" fill={C.floor} />
      <g class={kind === "abdominal" ? "f-thrust" : ""}>
        <rect x={kind === "abdominal" ? 188 : 232} y="176" width="16" height="58" rx="8" fill={C.pants} />
        <rect x={kind === "abdominal" ? 210 : 252} y="176" width="16" height="58" rx="8" fill={C.pants} />
        <rect x={kind === "abdominal" ? 182 : 226} y="104" width="52" height="84" rx="22" fill={C.res} />
        <circle cx={kind === "abdominal" ? 222 : 252} cy="86" r="21" fill={C.skin} />
        <path d={kind === "abdominal" ? "M203 80a21 21 0 0 1 40 0c-11-6-27-6-40 0Z" : "M233 80a21 21 0 0 1 40 0c-11-6-27-6-40 0Z"} fill={C.hair} />
      </g>
      <g transform={kind === "backblows" ? "rotate(-28 160 230)" : ""}>
        <rect x="142" y="196" width="12" height="40" rx="6" fill={C.pants} />
        <rect x="158" y="196" width="12" height="40" rx="6" fill={C.pants} />
        <rect x="136" y="146" width="40" height="56" rx="16" fill={C.victim} />
        <circle cx="156" cy="132" r="17" fill={C.skin} />
        <path d="M140 128a17 17 0 0 1 32-2c-9-4-22-4-32 2Z" fill="#7a4b2e" />
      </g>
      {kind === "cough" && (
        <g class="f-cough">
          <path d="M126 134c-10 0-16-6-16-12" fill="none" stroke={C.ink} stroke-width="3" stroke-linecap="round" />
          <path d="M120 146c-14 0-22-8-22-16" fill="none" stroke={C.ink} stroke-width="3" stroke-linecap="round" opacity=".6" />
          <text x="62" y="112" font-size="18" font-weight="800" fill={C.ink} font-family="var(--font-sans)">кхе!</text>
        </g>
      )}
      {kind === "cough" && <path d="M226 132 L184 150" stroke={C.skin} stroke-width="11" stroke-linecap="round" />}
      {kind === "backblows" && (
        <>
          <g class="f-blow"><path d="M232 120 L158 160" stroke={C.skin} stroke-width="12" stroke-linecap="round" /><circle cx="156" cy="161" r="9" fill={C.skin} /></g>
          <g class="f-impact"><circle cx="148" cy="166" r="16" fill="none" stroke={C.res} stroke-width="3" /></g>
        </>
      )}
      {kind === "abdominal" && <path d="M190 132 Q160 150 172 168" stroke={C.skin} stroke-width="11" stroke-linecap="round" fill="none" class="f-thrust" />}
      {(kind === "backblows" || kind === "abdominal") && (
        <g transform="translate(320 70)">
          <rect x="-40" y="-26" width="80" height="58" rx="16" fill={C.ink} />
          <text data-count data-to="5" data-every={kind === "backblows" ? 1000 : 1100} y="8" text-anchor="middle" font-size="30" font-weight="800" fill="#fff" font-family="var(--font-sans)">0</text>
          <text y="24" text-anchor="middle" font-size="11" fill="#fff" opacity=".7" font-family="var(--font-sans)">из 5</text>
        </g>
      )}
    </>
  )}

  {kind === "course" && (bleeding ? (
    <image href={bleedingTrainingIllustration} x="16" y="20" width="368" height="260" preserveAspectRatio="xMidYMid meet" />
  ) : (
    <>
      <image href={blsTrainingIllustration} x="16" y="28" width="368" height="250" preserveAspectRatio="xMidYMid meet" />
      <g class="f-slide" style="--d:2.2s">
        <rect x="297" y="181" width="83" height="58" rx="5" fill="#fff" stroke={C.floor} stroke-width="2" />
        <rect x="308" y="193" width="28" height="4" rx="2" fill={C.res} />
        <rect x="308" y="205" width="61" height="5" rx="2.5" fill={C.ink} opacity=".8" />
        <rect x="308" y="216" width="43" height="3" rx="1.5" fill={C.floor} />
        <circle cx="366" cy="226" r="6" fill={C.sun} />
      </g>
    </>
  ))}
  </>)}
</svg>

<style>
  /* Всё анимируется только в активной сцене; при показе сцены анимации начинаются заново */
  [class^="f-"], [class*=" f-"] { transform-box: fill-box; }
  :global(.film-scene:not([data-on])) * { animation: none !important; }
  .f-pop, .f-pad, .f-slide { opacity: 0; }
  :global(.film-scene[data-on]) .f-pop { animation: f-pop .5s cubic-bezier(.3,1.6,.5,1) var(--d, 0s) both; transform-origin: center; }
  :global(.film-scene[data-on]) .f-spin { animation: f-spin 1.4s linear infinite; transform-origin: 100% 100%; }
  :global(.film-scene[data-on]) .f-rescuer-press { animation: f-press .545s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-chest-press { animation: f-squash .545s ease-in-out infinite; transform-origin: 50% 100%; }
  :global(.film-scene[data-on]) .f-chest-rise { animation: f-rise 1.6s ease-in-out .3s 2; transform-origin: 50% 100%; }
  :global(.film-scene[data-on]) .f-shake { animation: f-shake .28s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-breath { animation: f-breath 1.2s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-timer { animation: f-timer 4.4s linear forwards; }
  :global(.film-scene[data-on]) .f-ring { animation: f-ring 1.6s ease-out var(--d, 0s) infinite; transform-origin: center; opacity: 0; }
  :global(.film-scene[data-on]) .f-wobble { animation: f-wobble 1.2s ease-in-out infinite; transform-origin: center; }
  :global(.film-scene[data-on]) .f-puff { animation: f-puff 1.6s ease-in-out .3s 2 both; }
  :global(.film-scene[data-on]) .f-blink { animation: f-blink .8s steps(2) infinite; }
  :global(.film-scene[data-on]) .f-pad { animation: f-pad .6s cubic-bezier(.2,.8,.3,1) var(--d) both; }
  :global(.film-scene[data-on]) .f-wire { animation: f-wire 1s linear infinite, f-show .3s 1.8s both; }
  .f-wire, .f-flash { opacity: 0; }
  :global(.film-scene[data-on]) .f-flash { animation: f-flash 1.1s 3s both; transform-origin: center; }
  :global(.film-scene[data-on]) .f-bleed { animation: f-pulse .8s ease-in-out 3, f-shrink .9s 2.3s forwards; transform-origin: center; }
  :global(.film-scene[data-on]) .f-press-hand { animation: f-hand 4.6s ease-in-out forwards; }
  :global(.film-scene[data-on]) .f-wrap { animation: f-wrap 3s ease-in-out .4s both; }
  :global(.film-scene[data-on]) .f-tighten { animation: f-tight .7s ease-in-out .5s 3; transform-origin: center; }
  :global(.film-scene[data-on]) .f-cough { animation: f-cough .9s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-blow { animation: f-blow 1s ease-in infinite; transform-origin: 100% 0%; }
  :global(.film-scene[data-on]) .f-impact { animation: f-impact 1s ease-out .3s infinite; transform-origin: center; opacity: 0; }
  :global(.film-scene[data-on]) .f-thrust { animation: f-thrust 1.1s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-slide { animation: f-slide .6s ease-out var(--d) both; }

  .f-speech-pop, .f-speech-right { opacity: 0; transform-origin: 15% 100%; }
  :global(.film-scene[data-on]) .f-speech-pop { animation: f-speech-pop .5s ease-out var(--d, .45s) both; }
  :global(.film-scene[data-on]) .f-speech-right { animation: f-speech-right .65s cubic-bezier(.2,.8,.3,1) var(--d, .8s) both; }
  :global(.film-scene[data-on]) .f-eye-scan { animation: f-eye-scan 2.4s linear infinite; }
  :global(.film-scene[data-on]) .f-eye-look { animation: f-eye-look 2.4s ease-in-out infinite; }
  :global(.film-scene[data-on]) .f-call-pulse { animation: f-call-pulse 1.6s ease-out infinite; transform-origin: center; }
  @keyframes f-speech-pop { from { opacity: 0; transform: translateY(7px) scale(.94); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes f-speech-right { from { opacity: 0; transform: translateX(32px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes f-eye-scan { to { stroke-dashoffset: -1; } }
  @keyframes f-eye-look { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-3px); } 65% { transform: translateX(3px); } }
  @keyframes f-call-pulse { from { opacity: .65; transform: scale(1); } to { opacity: 0; transform: scale(1.17); } }
  @media (prefers-reduced-motion: reduce) {
    .f-speech-pop, .f-speech-right { opacity: 1; }
    :global(.film-scene[data-on]) .f-speech-pop, :global(.film-scene[data-on]) .f-speech-right, :global(.film-scene[data-on]) .f-eye-look, :global(.film-scene[data-on]) .f-eye-scan, :global(.film-scene[data-on]) .f-call-pulse { animation: none; }
  }
  :global(.film-scene[data-on]) .f-compression-beat { animation: f-compression-beat .545s ease-in-out infinite; transform-origin: center; }
  @keyframes f-compression-beat { 0%, 100% { transform: scale(.92); opacity: .65; } 45% { transform: scale(1.06); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(.film-scene[data-on]) .f-compression-beat { animation: none; } }
  :global(.film-scene[data-on]) .f-rescue-air { animation: f-rescue-air 1.6s ease-in-out .3s 2 both; }
  @keyframes f-rescue-air { 0%, 100% { opacity: .2; transform: translateX(-3px); } 45% { opacity: 1; transform: translateX(3px); } }
  @media (prefers-reduced-motion: reduce) { :global(.film-scene[data-on]) .f-rescue-air { animation: none; } }
  :global(.film-scene[data-on]) .f-aed-light { animation: f-aed-light 1.6s ease-out infinite; transform-origin: center; }
  @keyframes f-aed-light { from { opacity: .8; transform: scale(1); } to { opacity: 0; transform: scale(2.1); } }
  @media (prefers-reduced-motion: reduce) { :global(.film-scene[data-on]) .f-aed-light { animation: none; opacity: 0; } }
  @keyframes f-pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: scale(1); } }
  @keyframes f-spin { to { transform: rotate(360deg); } }
  @keyframes f-press { 0%, 100% { transform: translateY(0); } 45% { transform: translateY(8px); } }
  @keyframes f-squash { 0%, 100% { transform: scaleY(1); } 45% { transform: scaleY(.8); } }
  @keyframes f-rise { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.18); } }
  @keyframes f-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
  @keyframes f-breath { 0%, 100% { opacity: .2; transform: translateX(0); } 50% { opacity: 1; transform: translateX(6px); } }
  @keyframes f-timer { from { stroke-dashoffset: 0; } to { stroke-dashoffset: 100; } }
  @keyframes f-ring { from { opacity: .8; transform: scale(.85); } to { opacity: 0; transform: scale(1.5); } }
  @keyframes f-wobble { 0%, 30%, 100% { transform: rotate(0); } 5%, 15%, 25% { transform: rotate(-5deg); } 10%, 20% { transform: rotate(5deg); } }

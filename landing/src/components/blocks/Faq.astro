---
/*
 * Частые вопросы. Вопрос о стоимости добавляется сам, с ценой для страны.
 * Варианты:
 *  list — раскрывающиеся вопросы, рядом карточка «Остались вопросы?» с менеджером
 *  chat — вопросы и ответы в виде переписки
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import { BrandIcon, MESSENGER_COLOR } from "@/components/parts/BrandIcon";
import { MESSENGER_LABEL, type Country, type Course } from "@/data";
import { INSTRUCTORS } from "@/data/about";
import { priceText } from "@/lib/price";

interface Props { variant?: "list" | "chat"; course: Course; country: Country }
const { variant = "list", course, country } = Astro.props;
const chats = country.messengers.filter((m) => m.id !== "instagram");
const faq: [string, string][] = [
  course.faq[0],
  ["Сколько стоит курс?", `${priceText(course, country)} за участника. В стоимость входит всё: ${course.price.includes.map((i) => i.toLowerCase()).join(", ")}.`],
  ...course.faq.slice(1),
];
---
<section class="py-16 md:py-28" id="faq">
  <div class="container-l">
    {variant === "list" && (
      <div class="grid gap-10 md:grid-cols-[1.4fr_.6fr] md:gap-14">
        <div>
          <h2 class="h-section" data-reveal>Частые вопросы</h2>
          <div class="mt-8">
            {faq.map(([q, a], i) => (
              <details class="group py-1" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                  {q}
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-soft transition-transform group-open:rotate-45 group-open:bg-brand-50 group-open:text-brand"><Icon name="Plus" size={18} /></span>
                </summary>
                <p class="pb-4 pr-12 text-[16px] leading-relaxed text-ink-2"><Rich text={a} /></p>
              </details>
            ))}
          </div>
        </div>

        <aside class="md:sticky md:top-28 md:self-start" data-reveal>
          <div class="overflow-hidden rounded-[28px] bg-white shadow-[0_20px_60px_-24px_rgba(17,19,23,.28)] ring-1 ring-black/5">
            <div class="bg-gradient-to-br from-brand-50 to-white p-6 pb-5">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-3">
                  {INSTRUCTORS.slice(0, 3).map((p) => (
                    <img src={p.img} alt="" loading="lazy" class="size-11 rounded-full object-cover object-top ring-[3px] ring-white" />
                  ))}
                </div>
                <div class="text-sm leading-tight">
                  <p class="flex items-center gap-1.5 font-semibold"><span class="size-2 rounded-full bg-emerald-500"></span>На связи в рабочее время</p>
                  <Rich as="p" class="text-muted-foreground" text="Отвечаем [[в среднем за 15 минут, пн–сб 9:00–19:00|Как быстро менеджеры отвечают в мессенджерах и в какие часы?]]" />
                </div>
              </div>
              <h3 class="mt-5 text-xl font-bold">Остались вопросы?</h3>
              <p class="mt-1 text-[15px] text-ink-2">Спросите нас в мессенджере — подскажем, какой курс подойдёт, и подберём дату.</p>
            </div>
            <div class="grid gap-2 p-4">
              {chats.map((m) => (
                <a href={m.href} class="flex h-12 items-center justify-center gap-2 rounded-2xl font-semibold text-white transition hover:brightness-95" style={`background:${MESSENGER_COLOR[m.id]}`}>
                  <BrandIcon id={m.id} tone="glyph" className="size-5" />Написать в {MESSENGER_LABEL[m.id]}
                </a>
              ))}
              <a href={country.phoneHref} class="flex h-12 items-center justify-center gap-2 rounded-2xl text-[15px] font-medium text-ink-2 transition hover:bg-soft">
                <Icon name="Phone" size={17} />{country.phone}
              </a>
            </div>
          </div>
        </aside>
      </div>
    )}

    {variant === "chat" && (
      <div class="mx-auto max-w-2xl">
        <h2 class="h-section text-center" data-reveal>Частые вопросы</h2>
        <div class="mt-10 grid gap-5 rounded-[32px] bg-soft p-4 md:p-8">
          {faq.map(([q, a]) => (
            <div class="grid gap-2" data-reveal>
              <p class="max-w-[85%] justify-self-end rounded-3xl rounded-br-md bg-brand px-5 py-3 text-[15.5px] font-medium text-white">{q}</p>
              <p class="max-w-[85%] justify-self-start rounded-3xl rounded-bl-md bg-white px-5 py-3 text-[15.5px] leading-relaxed text-ink-2 shadow-sm"><Rich text={a} /></p>
            </div>
          ))}
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            {chats.map((m) => (
              <a href={m.href} class="flex h-12 items-center justify-center gap-2 rounded-full font-semibold text-white transition hover:brightness-95" style={`background:${MESSENGER_COLOR[m.id]}`}>
                <BrandIcon id={m.id} tone="glyph" className="size-5" />Спросить в {MESSENGER_LABEL[m.id]}
              </a>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

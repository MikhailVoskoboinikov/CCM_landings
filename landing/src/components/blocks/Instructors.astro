---
/*
 * Инструкторы. Варианты:
 *  carousel — на телефоне лента, листается пальцем; на широком экране — ряд по центру
 *  lead     — один инструктор крупно и остальные списком
 * Сейчас — команда «Альфамедтренинга» как пример; для каждой страны нужен свой состав.
 */
import Rich from "@/components/parts/Rich.astro";
import { INSTRUCTORS } from "@/data/about";

interface Props { variant?: "carousel" | "lead" }
const { variant = "carousel" } = Astro.props;
const [first, ...rest] = INSTRUCTORS;
---
<section class="py-16 md:py-28" id="instructors">
  <div class="container-l">
    <div class="max-w-2xl" data-reveal>
      <h2 class="h-section">Инструкторы</h2>
      <Rich as="p" class="lead-text mt-4" text="[[Врачи и фельдшеры, которые сами работают в экстренной медицине и прошли аттестацию инструкторов|Сейчас показана команда «Альфамедтренинга» (Россия). Нужен состав инструкторов Ташкента и Бишкека с фото]]." />
    </div>
  </div>

  {variant === "carousel" && (
    <div class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2 [scrollbar-width:none] lg:container-l lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible">
      {INSTRUCTORS.map((p, i) => (
        <article class="group w-[72%] shrink-0 snap-start sm:w-[300px] lg:w-auto" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <div class="relative overflow-hidden rounded-3xl">
            <img src={p.img} alt={p.name} loading="lazy" class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-5 pt-16 text-white">
              <p class="text-xs font-medium text-white/75">Курсы: {p.courses}</p>
            </div>
          </div>
          <h3 class="mt-4 text-lg font-bold leading-snug">{p.name}</h3>
          <p class="text-[15px] font-medium text-brand">{p.role}</p>
          <p class="text-sm text-muted-foreground">{p.edu}</p>
        </article>
      ))}
    </div>
  )}

  {variant === "lead" && (
    <div class="container-l mt-10 grid items-center gap-8 md:grid-cols-[360px_1fr] md:gap-14">
      <img src={first.img} alt={first.name} loading="lazy" class="aspect-square w-full rounded-[28px] object-cover object-top" data-reveal />
      <div data-reveal>
        <p class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Ведущий инструктор</p>
        <h3 class="mt-2 text-3xl font-bold">{first.name}</h3>
        <p class="mt-1 text-lg font-medium text-brand">{first.role}</p>
        <dl class="mt-6 grid gap-3 text-[15.5px]">
          <div><dt class="text-sm text-muted-foreground">Образование</dt><dd>{first.edu}</dd></div>
          <div><dt class="text-sm text-muted-foreground">Инструктор курсов</dt><dd>{first.courses}</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          {rest.map((p) => (
            <div class="flex items-center gap-3 rounded-full bg-soft py-1.5 pl-1.5 pr-4">
              <img src={p.img} alt="" loading="lazy" class="size-10 rounded-full object-cover object-top" />
              <span class="text-sm leading-tight"><b class="block">{p.name}</b><span class="text-ink-2">{p.role}</span></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</section>

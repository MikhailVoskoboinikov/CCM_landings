---
/*
 * Первый экран. Варианты:
 *  ecg   — белый фон, бегущая кардиограмма, фото и плавающая карточка сертификата
 *  photo — фото на всю ширину, текст поверх
 *  cert  — в центре внимания образец сертификата
 * copy: a | b — два текста для A/B-теста в рекламе
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import Ecg from "@/components/parts/Ecg.astro";
import CertificateDoc from "@/components/parts/CertificateDoc.astro";
import { BrandIcon } from "@/components/parts/BrandIcon";
import { IMG, MESSENGER_LABEL, type Country, type Course, type ImageKey } from "@/data";

interface Props {
  variant?: "ecg" | "photo" | "cert";
  copy?: "a" | "b";
  course: Course;
  country: Country;
}
const { variant = "ecg", copy = "a", course, country } = Astro.props;
const t = course.hero[copy];
const img = IMG[course.hero.image as ImageKey];
const m = country.messengers[0];
---
{variant === "ecg" && (
  <section class="relative overflow-hidden pb-8 pt-6 md:pb-10 md:pt-14">
    <div class="container-l relative grid items-center gap-10 md:grid-cols-[1.1fr_.9fr] md:gap-16">
      <div>
        <h1 class="text-[34px] font-bold leading-[1.05] md:text-[60px]" data-reveal><Rich text={t.title} /></h1>
        <p class="lead-text mt-5 max-w-xl" data-reveal style="--reveal-delay:80ms"><Rich text={t.sub} /></p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay:160ms">
          <button data-lead-open={course.id} class="h-14 flex-1 rounded-full bg-brand px-8 text-base font-semibold text-white shadow-[0_12px_30px_-10px_var(--brand)] transition hover:bg-brand-600 sm:flex-none">Записаться на курс</button>
          <a href={m.href} class="flex h-14 items-center gap-2 rounded-full bg-soft px-6 font-semibold transition hover:bg-line">
            <BrandIcon id={m.id} className="size-5 text-brand" />{MESSENGER_LABEL[m.id]}
          </a>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4 md:grid-cols-2 lg:grid-cols-4" data-reveal style="--reveal-delay:240ms">
          {course.facts.map((f) => (
            <div class="flex flex-col gap-1">
              <dt class="flex items-center gap-1.5 text-[13px] text-muted-foreground"><Icon name={f.icon} size={15} class="text-brand" />{f.label}</dt>
              <dd class="text-[15px] font-semibold leading-snug"><Rich text={f.value} /></dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="relative" data-reveal style="--reveal-delay:120ms">
        <img src={img} alt="" class="aspect-[4/5] w-full rounded-[28px] object-cover md:rounded-[36px]" loading="eager" />
        <div class="absolute -bottom-6 -left-3 w-[62%] max-w-[300px] animate-float md:-left-10" style="--r:-4deg">
          <CertificateDoc course={course} />
        </div>
      </div>
    </div>
    <Ecg class="mt-16 block h-20 w-full text-brand md:mt-20 md:h-24" />
  </section>
)}

{variant === "photo" && (
  <section class="relative">
    <div class="relative h-[58vh] min-h-[380px] md:h-[88vh] md:max-h-[820px]">
      <img src={img} alt="" class="absolute inset-0 size-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-white via-white/10 to-transparent md:bg-gradient-to-r md:from-black/75 md:via-black/35 md:to-transparent"></div>
      <div class="container-l relative hidden h-full flex-col justify-center text-white md:flex">
        <h1 class="max-w-2xl text-[64px] font-bold leading-[1.02]"><Rich text={t.title} /></h1>
        <p class="mt-6 max-w-xl text-xl text-white/85"><Rich text={t.sub} /></p>
        <div class="mt-10 flex gap-3">
          <button data-lead-open={course.id} class="h-14 rounded-full bg-brand px-9 font-semibold text-white transition hover:bg-brand-600">Записаться на курс</button>
          <a href={m.href} class="flex h-14 items-center gap-2 rounded-full bg-white/15 px-6 font-semibold backdrop-blur-md transition hover:bg-white/25"><BrandIcon id={m.id} className="size-5" />{MESSENGER_LABEL[m.id]}</a>
        </div>
        <div class="mt-14 flex gap-3">
          {course.facts.map((f) => (
            <div class="rounded-2xl bg-white/12 px-4 py-3 backdrop-blur-md ring-1 ring-white/20">
              <p class="text-xs text-white/70">{f.label}</p>
              <p class="text-[15px] font-semibold"><Rich text={f.value} /></p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="container-l relative -mt-24 pb-12 md:hidden">
      <h1 class="text-[34px] font-bold leading-[1.05]"><Rich text={t.title} /></h1>
      <p class="lead-text mt-4"><Rich text={t.sub} /></p>
      <button data-lead-open={course.id} class="mt-7 h-14 w-full rounded-full bg-brand font-semibold text-white">Записаться на курс</button>
      <div class="mt-6 grid grid-cols-2 gap-2.5">
        {course.facts.map((f) => (
          <div class="rounded-2xl bg-soft px-4 py-3">
            <p class="text-xs text-muted-foreground">{f.label}</p>
            <p class="text-[15px] font-semibold leading-snug"><Rich text={f.value} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{variant === "cert" && (
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 to-white pb-14 pt-8 md:pb-24 md:pt-16">
    <div class="pointer-events-none absolute -right-40 -top-40 size-[520px] rounded-full bg-brand/10 blur-3xl"></div>
    <div class="container-l relative grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="order-2 md:order-1">
        <h1 class="text-[34px] font-bold leading-[1.05] md:text-[56px]" data-reveal><Rich text={t.title} /></h1>
        <p class="lead-text mt-5" data-reveal style="--reveal-delay:80ms"><Rich text={t.sub} /></p>
        <ul class="mt-7 grid gap-3" data-reveal style="--reveal-delay:160ms">
          {course.facts.map((f) => (
            <li class="flex items-center gap-3 text-[15px]">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white text-brand shadow-sm"><Icon name={f.icon} size={18} /></span>
              <span><span class="text-muted-foreground">{f.label}:</span> <b class="font-semibold"><Rich text={f.value} /></b></span>
            </li>
          ))}
        </ul>
        <button data-lead-open={course.id} class="mt-9 h-14 w-full rounded-full bg-brand px-9 font-semibold text-white transition hover:bg-brand-600 sm:w-auto" data-reveal style="--reveal-delay:220ms">Записаться на курс</button>
      </div>
      <div class="order-1 md:order-2" data-reveal>
        <div class="mx-auto max-w-[520px] rotate-[-3deg] transition-transform duration-700 hover:rotate-0">
          <CertificateDoc course={course} />
        </div>
      </div>
    </div>
  </section>
)}

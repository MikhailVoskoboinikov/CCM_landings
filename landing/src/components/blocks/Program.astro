---
/*
 * Программа. Варианты:
 *  accordion — раскрывающийся список разделов, как просили в ЦКМ
 *  timeline  — вертикальная красная линия, в стиле globalccm.com
 *  day       — как проходит день + темы чипами
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import type { Course } from "@/data";

interface Props { variant?: "accordion" | "timeline" | "day"; course: Course }
const { variant = "accordion", course } = Astro.props;
const p = course.program;
const total = p.sections.reduce((n, s) => n + s.items.length, 0);
const day = [
  { t: "Демонстрация", d: "Инструктор показывает алгоритм целиком, в реальном темпе" },
  { t: "Отработка", d: "В малых группах, у каждого своё время на манекене" },
  { t: "Сценарии", d: "Ситуации, приближенные к реальным" },
  { t: "Экзамен", d: "Оценка навыков и разбор с инструктором" },
];
---
<section class="py-16 md:py-28" id="program">
  <div class="container-l">
    {p.draft && <p class="mb-6 inline-block rounded-lg bg-[#fff5d6] px-3 py-1.5 text-sm text-[#7a5200]">Черновик программы по брифу — согласовать с ЦКМ</p>}
    <div class="grid gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start" data-reveal>
        <h2 class="h-section">Программа курса</h2>
        <p class="lead-text mt-4"><Rich text={p.lead} /></p>
        <div class="mt-8 flex gap-8">
          <div><p class="text-4xl font-bold text-brand">{p.sections.length}</p><p class="text-sm text-ink-2">раздела</p></div>
          <div><p class="text-4xl font-bold text-brand">{total}</p><p class="text-sm text-ink-2">тем</p></div>
          <div><p class="text-4xl font-bold text-brand">4–8</p><p class="text-sm text-ink-2">часов</p></div>
        </div>
      </div>

      {variant === "accordion" && (
        <div class="grid gap-3">
          {p.sections.map((s, i) => (
            <details class="group rounded-3xl bg-soft transition-colors open:bg-white open:shadow-[0_8px_40px_-16px_rgba(17,19,23,.2)] open:ring-1 open:ring-black/5" open={i === 0} data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <summary class="flex cursor-pointer list-none items-center gap-4 p-5 md:p-6 [&::-webkit-details-marker]:hidden">
                <span class="text-sm font-bold text-brand tabular-nums">0{i + 1}</span>
                <span class="flex-1 text-lg font-bold md:text-xl">{s.title}</span>
                <span class="text-sm text-muted-foreground">{s.items.length}</span>
                <span class="grid size-9 place-items-center rounded-full bg-white transition-transform group-open:rotate-45 group-open:bg-brand group-open:text-white"><Icon name="Plus" size={18} /></span>
              </summary>
              <ul class="grid gap-2.5 px-5 pb-6 md:px-6 md:pl-[3.9rem]">
                {s.items.map((it) => (
                  <li class="flex gap-3 text-[15.5px] text-ink-2"><Icon name="Check" size={18} class="mt-0.5 shrink-0 text-brand" />{it}</li>
                ))}
              </ul>
            </details>
          ))}
          <div class="flex gap-4 rounded-3xl bg-brand p-5 text-white md:p-6" data-reveal>
            <Icon name="BadgeCheck" size={26} class="shrink-0" />
            <p class="text-[15.5px] leading-relaxed"><b class="block text-lg">Экзамен</b><Rich text={p.exam} /></p>
          </div>
        </div>
      )}

      {variant === "timeline" && (
        <ol class="relative">
          {p.sections.map((s, i) => (
            <li class="relative grid grid-cols-[18px_1fr] gap-5 pb-10 last:pb-0" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              {i < p.sections.length - 1 && <span class="absolute left-[8px] top-6 h-full w-0.5 bg-brand/80" aria-hidden="true"></span>}
              <span class="relative mt-1.5 size-[18px] rounded-full bg-brand ring-4 ring-brand-50"></span>
              <div>
                <h3 class="text-xl font-bold">{s.title}</h3>
                <ul class="mt-3 grid gap-2">
                  {s.items.map((it) => <li class="text-[16px] text-ink-2">{it}</li>)}
                </ul>
              </div>
            </li>
          ))}
          <li class="relative mt-10 grid grid-cols-[18px_1fr] gap-5" data-reveal>
            <span class="mt-1 grid size-[18px] place-items-center rounded-full bg-sun"></span>
            <div><h3 class="text-xl font-bold">Экзамен</h3><p class="mt-2 text-ink-2"><Rich text={p.exam} /></p></div>
          </li>
        </ol>
      )}

      {variant === "day" && (
        <div>
          <ol class="grid gap-3 sm:grid-cols-2">
            {day.map((d, i) => (
              <li class="relative overflow-hidden rounded-3xl bg-soft p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <span class="absolute -right-2 -top-4 text-[88px] font-bold leading-none text-brand/10">{i + 1}</span>
                <h3 class="relative text-lg font-bold">{d.t}</h3>
                <p class="relative mt-2 text-[15px] text-ink-2">{d.d}</p>
              </li>
            ))}
          </ol>
          <h3 class="mt-10 text-sm font-semibold uppercase tracking-wider text-muted-foreground">Темы курса</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.sections.flatMap((s) => s.items).map((it) => (
              <span class="rounded-full border border-line px-4 py-2 text-[14.5px]">{it}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

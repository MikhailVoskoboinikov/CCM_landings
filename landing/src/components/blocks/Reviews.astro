---
/*
 * Отзывы — бегущая лента справа налево, останавливается при наведении и касании.
 * Варианты:
 *  cards — текстовые отзывы
 *  video — вертикальные видеоотзывы
 * Пока в data/about.ts примеры текста: они видны только в макете и на тестовом
 * стенде (с пометками). В боевой сборке блок с примерами не выводится.
 */
import Icon from "@/components/parts/Icon.astro";
import ReviewShowcase from "@/components/parts/ReviewShowcase.astro";
import Rich from "@/components/parts/Rich.astro";
import Marquee from "@/components/parts/Marquee.astro";
import { REVIEWS, REVIEWS_ARE_SAMPLES } from "@/data/about";
import { showMarks } from "@/lib/rich";

interface Props { variant?: "cards" | "video"; revised?: boolean }
const { variant = "cards", revised = false } = Astro.props;
const hidden = REVIEWS_ARE_SAMPLES && !showMarks;
const mark = (t: string) => (REVIEWS_ARE_SAMPLES ? `[[${t}|Пример отзыва для макета — нужен реальный текст, имя и согласие автора]]` : t);
---
{!hidden && (
  <section class:list={["bg-soft", revised ? "py-12 md:py-16" : "py-16 md:py-28"]} id="reviews">
    <div class="container-l" data-reveal>
      <h2 class="h-section">Отзывы выпускников</h2>
    </div>
    {revised && variant === "cards" ? <ReviewShowcase /> : (
    <Marquee class="mt-10 py-2" repeat={2} duration={variant === "video" ? 55 : 80}>
      {REVIEWS.map((r) =>
        variant === "video" ? (
          <article class="relative mr-5 flex aspect-[9/14] w-[240px] shrink-0 flex-col justify-end overflow-hidden rounded-3xl bg-ink p-5 text-white md:w-[280px]">
            <span class="absolute inset-0 grid place-items-center"><span class="grid size-16 place-items-center rounded-full bg-brand"><Icon name="Play" size={26} class="ml-1" /></span></span>
            <p class="relative font-semibold">{r.name}</p>
            <Rich as="p" class="relative text-sm text-white/75" text={mark(r.who)} />
          </article>
        ) : (
          <article class="mr-5 flex w-[310px] shrink-0 flex-col rounded-[28px] bg-white p-7 shadow-[0_10px_40px_-20px_rgba(17,19,23,.2)] md:w-[460px] md:p-9">
            <div class="flex gap-0.5 text-sun">
              {Array.from({ length: 5 }, () => <Icon name="Star" size={20} class="fill-current" />)}
            </div>
            <Rich as="p" class="mt-5 flex-1 text-[16px] leading-relaxed text-ink md:text-[18px]" text={mark(r.text)} />
            <div class="mt-7 flex items-center gap-3">
              <span class="grid size-12 place-items-center rounded-full bg-brand-50 text-lg font-bold text-brand">{r.name[0]}</span>
              <div><p class="font-semibold">{r.name}</p><p class="text-sm text-muted-foreground">{r.who}</p></div>
            </div>
          </article>
        ),
      )}
    </Marquee>
    )}
  </section>
)}

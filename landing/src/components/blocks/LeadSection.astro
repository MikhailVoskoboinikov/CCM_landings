---
/*
 * Заявка внизу страницы. Варианты:
 *  form       — форма прямо на странице, рядом стоимость и контакты
 *  messengers — крупные кнопки мессенджеров и одна кнопка шторки
 * Стоимость живёт здесь, а не отдельным блоком: цена — часть решения записаться.
 * В форме на телефоне порядок: заголовок → форма → стоимость; на компьютере форма справа на всю высоту.
 */
import { LeadForm } from "@/components/lead/LeadForm";
import HeaderMessengerIcon from "@/components/parts/HeaderMessengerIcon.astro";
import Ecg from "@/components/parts/Ecg.astro";
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import { priceText } from "@/lib/price";
import { COURSE_LIST, MESSENGER_LABEL, type Country, type Course } from "@/data";

interface Props { variant?: "form" | "messengers"; course: Course; country: Country }
const { variant = "form", course, country } = Astro.props;
const modes = course.org.modes;
const courses = COURSE_LIST.map((c) => ({ id: c.id, name: c.name }));
---
<section class="relative overflow-hidden bg-soft pb-8 pt-14 md:pb-10 md:pt-28" id="lead">
  <div class="container-l relative">
    {variant === "form" && (
      <div class="grid gap-8 md:grid-cols-2 md:grid-rows-[auto_1fr] md:gap-x-16 md:gap-y-8 [&>*]:min-w-0">
        <div data-reveal>
          <h2 class="h-section">Запишитесь на курс</h2>
          <p class="lead-text mt-4">Оставьте контакты — перезвоним, ответим на вопросы и подберём дату.</p>
        </div>
        <div class="rounded-[28px] bg-white p-6 shadow-[0_20px_60px_-24px_rgba(17,19,23,.25)] md:col-start-2 md:row-span-2 md:row-start-1 md:self-start md:p-8" data-reveal>
          <LeadForm client:visible country={country} courses={courses} courseId={course.id} />
        </div>
        <div data-reveal>
          <div class="rounded-3xl bg-white p-5 md:p-6" data-mode={modes ? "self" : undefined}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="text-sm text-muted-foreground">Стоимость курса</p>
              <p class="text-2xl font-bold tracking-tight md:text-[28px]"><Rich text={priceText(course, country)} /> <span class="text-sm font-medium text-muted-foreground">за участника</span></p>
            </div>
            <ul class="mt-4 grid gap-2 text-[15px] text-ink-2 sm:grid-cols-2">
              {course.price.includes.map((i) => <li class="flex gap-2"><Icon name="Check" size={18} class="mt-0.5 shrink-0 text-brand" />{i}</li>)}
            </ul>
            <Rich as="p" class="mt-4 text-sm text-ink-2" text={`Для групп — [[скидка от ${course.price.groupDiscounts[0].from} человек|Есть ли групповые скидки и какие?]]`} />
          </div>
          <div class="mt-6 hidden gap-1 md:grid">
            <a href={country.phoneHref} class="text-xl font-bold">{country.phone}</a>
            <p class="text-ink-2">{country.address}</p>
          </div>
          <div class="mt-5 hidden flex-wrap gap-2 md:flex">
            {country.messengers.map((m) => (
              <a href={m.href} class="flex h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold shadow-sm transition hover:text-brand">
                <span class="text-brand"><HeaderMessengerIcon id={m.id} /></span>{MESSENGER_LABEL[m.id]}
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    {variant === "messengers" && (
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="h-section">Запишитесь на курс</h2>
        <p class="lead-text mt-4">Напишите в удобный мессенджер или оставьте номер — мы перезвоним.</p>
        <p class="mt-6 inline-flex flex-wrap items-baseline justify-center gap-x-2 rounded-full bg-white px-5 py-2.5"><span class="text-sm text-muted-foreground">Стоимость</span><b class="text-lg"><Rich text={priceText(course, country)} /></b><span class="text-sm text-muted-foreground">за участника, всё включено</span></p>
        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          {country.messengers.map((m, i) => (
            <a href={m.href} class={`flex h-16 items-center justify-center gap-2.5 rounded-2xl text-base font-semibold transition ${i === 0 ? "bg-brand text-white hover:bg-brand-600" : "bg-white hover:text-brand"}`}>
              <span class={i === 0 ? "[--glyph:var(--brand)]" : "text-brand"}><HeaderMessengerIcon id={m.id} /></span>{MESSENGER_LABEL[m.id]}
            </a>
          ))}
        </div>
        <button data-lead-open={course.id} class="mt-4 h-14 w-full rounded-2xl bg-ink text-base font-semibold text-white transition hover:bg-black">Оставить номер для звонка</button>
        <p class="mt-6 text-ink-2">{country.phone} · {country.address}</p>
      </div>
    )}
  </div>
  <Ecg class="mt-16 block h-20 w-full text-brand md:mt-20 md:h-24" />
</section>

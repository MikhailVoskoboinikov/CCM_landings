---
/*
 * Заявка внизу страницы. Варианты:
 *  form       — форма прямо на странице, рядом контакты
 *  messengers — крупные кнопки мессенджеров и одна кнопка шторки
 */
import { LeadForm } from "@/components/lead/LeadForm";
import { BrandIcon } from "@/components/parts/BrandIcon";
import Ecg from "@/components/parts/Ecg.astro";
import { COURSE_LIST, MESSENGER_LABEL, type Country, type Course } from "@/data";

interface Props { variant?: "form" | "messengers"; course: Course; country: Country }
const { variant = "form", course, country } = Astro.props;
const courses = COURSE_LIST.map((c) => ({ id: c.id, name: c.name }));
---
<section class="relative overflow-hidden bg-soft py-16 md:py-28" id="lead">
  <Ecg class="pointer-events-none absolute inset-x-0 bottom-10 h-24 w-full text-brand" beats={7} />
  <div class="container-l relative">
    {variant === "form" && (
      <div class="grid gap-10 md:grid-cols-2 md:gap-16 [&>*]:min-w-0">
        <div data-reveal>
          <h2 class="h-section">Запишитесь на курс</h2>
          <p class="lead-text mt-4">Оставьте контакты — менеджер перезвонит, ответит на вопросы и подберёт дату.</p>
          <div class="mt-8 grid gap-2">
            <a href={country.phoneHref} class="text-2xl font-bold">{country.phone}</a>
            <p class="text-ink-2">{country.address}</p>
          </div>
          <div class="mt-6 flex gap-2">
            {country.messengers.map((m) => (
              <a href={m.href} class="flex h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold shadow-sm transition hover:text-brand">
                <BrandIcon id={m.id} className="size-5 text-brand" />{MESSENGER_LABEL[m.id]}
              </a>
            ))}
          </div>
        </div>
        <div class="rounded-[28px] bg-white p-6 shadow-[0_20px_60px_-24px_rgba(17,19,23,.25)] md:p-8" data-reveal>
          <LeadForm client:visible country={country} courses={courses} courseId={course.id} />
        </div>
      </div>
    )}

    {variant === "messengers" && (
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="h-section">Запишитесь на курс</h2>
        <p class="lead-text mt-4">Напишите в удобный мессенджер или оставьте номер — мы перезвоним.</p>
        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          {country.messengers.map((m, i) => (
            <a href={m.href} class={`flex h-16 items-center justify-center gap-2.5 rounded-2xl text-base font-semibold transition ${i === 0 ? "bg-brand text-white hover:bg-brand-600" : "bg-white hover:text-brand"}`}>
              <BrandIcon id={m.id} className="size-6" />{MESSENGER_LABEL[m.id]}
            </a>
          ))}
        </div>
        <button data-lead-open={course.id} class="mt-4 h-14 w-full rounded-2xl bg-ink text-base font-semibold text-white transition hover:bg-black">Оставить номер для звонка</button>
        <p class="mt-6 text-ink-2">{country.phone} · {country.address}</p>
      </div>
    )}
  </div>
</section>

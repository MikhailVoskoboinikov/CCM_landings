---
/*
 * Чему научитесь. На компьютере всегда 6 карточек. Варианты — что на телефоне:
 *  swipe — лента карточек, листается пальцем вбок; карточка доезжает до края сама
 *  list  — компактный список с круглыми фото, помещается в один экран
 */
import Rich from "@/components/parts/Rich.astro";
import { IMG, type Course, type ImageKey } from "@/data";

interface Props { variant?: "swipe" | "list"; course: Course }
const { variant = "swipe", course } = Astro.props;
const s = course.skills;
const n = s.items.length;
---
<section class="py-14 md:py-24" id="skills">
  <div class="container-l">
    <div class="max-w-2xl" data-reveal>
      <h2 class="h-section">{s.title}</h2>
      <Rich as="p" class="lead-text mt-3" text={s.lead} />
    </div>
  </div>

  <div class="container-l hidden md:block">
    <div class="mt-12 grid grid-cols-3 gap-6">
      {s.items.map((it, i) => (
        <article class="flex min-w-0 flex-col overflow-hidden rounded-3xl bg-soft" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <img src={IMG[it.image as ImageKey]} alt="" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-bold leading-snug">{it.title}</h3>
            <Rich as="p" class="mt-1.5 text-[15.5px] leading-relaxed text-ink-2" text={it.text} />
          </div>
        </article>
      ))}
    </div>
  </div>

  {variant === "list" && (
    <ol class="container-l mt-8 grid gap-3 md:hidden">
      {s.items.map((it, i) => (
        <li class="flex items-center gap-4" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <span class="relative shrink-0">
            <img src={IMG[it.image as ImageKey]} alt="" loading="lazy" decoding="async" class="size-[68px] rounded-full object-cover" />
            <span class="absolute -right-1 -top-1 grid size-6 place-items-center rounded-full bg-brand text-[12px] font-bold text-white ring-2 ring-white">{i + 1}</span>
          </span>
          <div class="min-w-0">
            <h3 class="text-[16.5px] font-bold leading-snug">{it.title}</h3>
            <Rich as="p" class="mt-0.5 text-[14.5px] leading-snug text-ink-2" text={it.text} />
          </div>
        </li>
      ))}
    </ol>
  )}

  {variant === "swipe" && (
    <div class="md:hidden">
      <div class="mt-7 flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain scroll-px-5 px-5 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-skill-track>
        {s.items.map((it, i) => (
          <article class="flex w-[82%] shrink-0 snap-start flex-col overflow-hidden rounded-3xl bg-soft" data-skill-card>
            <img src={IMG[it.image as ImageKey]} alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
            <div class="p-5">
              <p class="text-[13px] font-semibold text-brand">{i + 1} из {n}</p>
              <h3 class="mt-1 text-[19px] font-bold leading-snug">{it.title}</h3>
              <Rich as="p" class="mt-1 text-[15px] leading-snug text-ink-2" text={it.text} />
            </div>
          </article>
        ))}
      </div>
      <div class="mt-5 flex justify-center gap-1.5" aria-hidden="true">
        {s.items.map((_, i) => <span class={`h-1.5 w-1.5 rounded-full bg-line transition-all duration-300 data-[on]:w-5 data-[on]:bg-brand`} data-on={i === 0 ? "" : undefined} data-skill-dot></span>)}
      </div>
    </div>
  )}
</section>

<script>
  // Лента навыков листается пальцем вбок; точки показывают карточку у левого края
  document.querySelectorAll<HTMLElement>("[data-skill-track]").forEach((track) => {
    const cards = [...track.querySelectorAll<HTMLElement>("[data-skill-card]")];
    const dots = [...track.parentElement!.querySelectorAll<HTMLElement>("[data-skill-dot]")];
    let raf = 0;
    const update = () => {
      raf = 0;
      const step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : 1;
      const end = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
      const i = end ? cards.length - 1 : Math.round(track.scrollLeft / step);
      dots.forEach((d, k) => d.toggleAttribute("data-on", k === i));
    };
    track.addEventListener("scroll", () => (raf ||= requestAnimationFrame(update)), { passive: true });
  });
</script>

---
/*
 * Чему научитесь. Варианты:
 *  list  — компактный список с круглыми фото: шесть навыков помещаются в один экран телефона
 *  cards — карточки с крупным фото
 */
import Rich from "@/components/parts/Rich.astro";
import { IMG, type Course, type ImageKey } from "@/data";

interface Props { variant?: "list" | "cards"; course: Course }
const { variant = "list", course } = Astro.props;
const s = course.skills;
---
<section class="py-14 md:py-24" id="skills">
  <div class="container-l">
    <div class="max-w-2xl" data-reveal>
      <h2 class="h-section">{s.title}</h2>
      <Rich as="p" class="lead-text mt-3" text={s.lead} />
    </div>
    {variant === "list" && (
      <ol class="mt-8 grid gap-x-10 gap-y-3 md:mt-12 md:grid-cols-2 md:gap-y-5">
        {s.items.map((it, i) => (
          <li class="flex items-center gap-4" data-reveal style={`--reveal-delay:${i * 50}ms`}>
            <span class="relative shrink-0">
              <img src={IMG[it.image as ImageKey]} alt="" loading="lazy" decoding="async" class="size-[68px] rounded-full object-cover md:size-20" />
              <span class="absolute -right-1 -top-1 grid size-6 place-items-center rounded-full bg-brand text-[12px] font-bold text-white ring-2 ring-white">{i + 1}</span>
            </span>
            <div class="min-w-0">
              <h3 class="text-[16.5px] font-bold leading-snug md:text-lg">{it.title}</h3>
              <Rich as="p" class="mt-0.5 text-[14.5px] leading-snug text-ink-2 md:text-[15.5px]" text={it.text} />
            </div>
          </li>
        ))}
      </ol>
    )}
    {variant === "cards" && (
      <div class="mt-8 grid grid-cols-2 gap-3 md:mt-12 md:gap-6 lg:grid-cols-3">
        {s.items.map((it, i) => (
          <article class="flex min-w-0 flex-col overflow-hidden rounded-3xl bg-soft" data-reveal style={`--reveal-delay:${i * 50}ms`}>
            <img src={IMG[it.image as ImageKey]} alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
            <div class="p-4 md:p-6">
              <h3 class="text-[15.5px] font-bold leading-snug md:text-lg">{it.title}</h3>
              <Rich as="p" class="mt-1.5 hidden text-[15px] leading-relaxed text-ink-2 sm:block" text={it.text} />
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

---
import Icon from "@/components/parts/Icon.astro";
import { IMG } from "@/data";
import { BLS_UZ_SKILLS } from "@/data/bls-uz";

const content = BLS_UZ_SKILLS;
---
<section class="py-16 md:py-28" id="skills" aria-labelledby="skills-title">
  <div class="container-l">
    <div class="max-w-2xl" data-reveal>
      <h2 class="h-section" id="skills-title">{content.title}</h2>
      <p class="lead-text mt-4">{content.lead}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 md:mt-12 md:gap-6" data-skills-grid>
      {content.items.map((item) => (
        <article class="flex min-w-0 flex-col overflow-hidden rounded-3xl bg-soft" data-skill-card data-reveal>
          <img src={IMG[item.image]} alt="Практическое занятие по оказанию помощи" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
          <div class="flex flex-1 flex-col p-6">
            <div class="flex min-h-14 items-center gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-50 text-brand">
              {item.icon === "Choking" ? (
                <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="4.5" r="3" />
                  <path d="M8 9c-4 1-5 6-4 10 .3 1 1.4 1.3 2.3.6L12 14m4-5c4 1 5 6 4 10-.3 1-1.4 1.3-2.3.6L12 14M7 14l4-5m6 5-4-5M7 20v2m10-2v2" />
                </svg>
              ) : item.icon === "RecoveryPosition" ? (
                <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="3.5" cy="5.5" r="2" />
                  <path d="M6.5 8.5c1.6-.2 2.7 1.3 4.2 1l4.6-1.2c1.3-.4 2.3.4 2.1 1.6-.2 1-1.1 1.5-2.2 1.8l-3.5 1 1.5 1.5 5.5-.5c.9-.1 1.5.4 2.2.8l1.4 1c.7.5 1.1 1 1.1 1.8 0 1.2-.8 1.9-1.9 1.9-.6 0-1.1-.3-1.6-.6l-2.7-1.6c-.7-.4-1.2-.5-2-.4l-3.8.7c-1.5.2-2.2.2-3.2-.6L6 13.4c-1.2-1-1.8-2.4-1.3-3.6.3-.7 1-1.2 1.8-1.3Z" />
                </svg>
              ) : item.icon === "Baby" ? (
                <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="8" />
                  <path d="M4 10a2 2 0 0 0 0 4m16-4a2 2 0 0 1 0 4M12 4c-2 0-3 1-3 2a2 2 0 0 0 4 0" />
                </svg>
              ) : <Icon name={item.icon} size={22} />}
            </span>
            <h3 class="min-w-0 text-lg font-bold leading-snug">{item.title}</h3>
            </div>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

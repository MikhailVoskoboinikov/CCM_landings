---
/* Нижняя панель на телефоне: появляется, когда первый экран ушёл вверх */
import { BrandIcon } from "@/components/parts/BrandIcon";
import type { Country, Course } from "@/data";

interface Props { course: Course; country: Country }
const { course, country } = Astro.props;
const m = country.messengers[0];
---
<div data-sticky-cta class="fixed inset-x-0 bottom-0 z-40 translate-y-full bg-white/95 px-3 pb-[calc(10px+env(safe-area-inset-bottom))] pt-2.5 shadow-[0_-8px_30px_-12px_rgba(17,19,23,.2)] backdrop-blur-md transition-transform duration-300 data-[on]:translate-y-0 md:hidden">
  <div class="flex gap-2">
    <button data-lead-open={course.id} class="h-13 flex-1 rounded-full bg-brand text-base font-semibold text-white">Записаться на курс</button>
    <a href={m.href} aria-label={m.id} class="grid size-13 place-items-center rounded-full bg-soft text-brand"><BrandIcon id={m.id} className="size-6" /></a>
  </div>
</div>
<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-cta]");
  if (bar) {
    const on = () => bar.toggleAttribute("data-on", scrollY > innerHeight * 0.7);
    on();
    addEventListener("scroll", on, { passive: true });
  }
</script>

---
/*
 * «Для кого». Варианты:
 *  cards — плитки 2 × 2 на телефоне, в ряд на компьютере; без горизонтальной прокрутки
 *  list  — крупная мысль слева, список справа
 * Если у курса есть режим «Для организации», рисуются обе версии, видна одна (data-mode).
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import type { Course } from "@/data";

interface Props { variant?: "cards" | "list"; course: Course }
const { variant = "cards", course } = Astro.props;
const modes = course.org.modes;
const versions = [
  { mode: modes ? "self" : undefined, ...course.audience },
  ...(modes ? [{ mode: "org", ...modes.audience }] : []),
];
---
{versions.map((a) => variant === "cards" ? (
  <section class="py-14 md:py-24" data-mode={a.mode}>
    <div class="container-l">
      <div class="max-w-2xl" data-reveal>
        <h2 class="h-section">{a.title}</h2>
        <Rich as="p" class="lead-text mt-4" text={a.lead} />
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:mt-12 md:gap-5 lg:grid-cols-4">
        {a.items.map((it, i) => (
          <article class="audience-card group flex flex-col rounded-3xl bg-soft p-4 transition-colors hover:bg-brand-50 md:p-6" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-white text-brand shadow-sm md:size-12"><Icon name={it.icon} size={22} animated /></span>
            <h3 class="mt-4 text-[16px] font-bold leading-snug md:mt-8 md:text-lg">{it.title}</h3>
            <Rich as="p" class="mt-1.5 text-[14px] leading-snug text-ink-2 md:mt-2 md:text-[15px] md:leading-relaxed" text={it.text} />
          </article>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="py-14 md:py-24" data-mode={a.mode}>
    <div class="container-l grid gap-8 md:grid-cols-[.9fr_1.1fr] md:gap-20">
      <div data-reveal>
        <h2 class="h-section">{a.title}</h2>
        <Rich as="p" class="mt-5 text-xl font-semibold leading-snug md:text-[30px]" text={a.lead} />
      </div>
      <ul class="grid gap-1">
        {a.items.map((it, i) => (
          <li class="audience-card flex gap-4 rounded-2xl p-3 transition-colors hover:bg-soft md:p-5" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand text-white"><Icon name={it.icon} size={20} animated /></span>
            <div>
              <h3 class="text-[17px] font-bold md:text-lg">{it.title}</h3>
              <Rich as="p" class="mt-1 text-[15px] text-ink-2" text={it.text} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
))}

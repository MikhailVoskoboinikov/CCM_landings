---
/*
 * Клиенты — бегущая строка сразу после «О ЦКМ», как просили в ЦКМ.
 * Варианты: marquee — бегущая строка; grid — сетка.
 * Пока показаны отрасли: нужны реальные логотипы и разрешение компаний.
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import Marquee from "@/components/parts/Marquee.astro";
import { CLIENTS } from "@/data/about";

interface Props { variant?: "marquee" | "grid" }
const { variant = "marquee" } = Astro.props;
const title = "[[Обучаем сотрудников компаний из разных отраслей|Логотипы клиентов и разрешение на их показ — сейчас вместо них отрасли]]";
---
<section class="py-12 md:py-16">
  <div class="container-l">
    <Rich as="h2" class="text-xl font-bold md:text-2xl" text={title} />
  </div>
  {variant === "marquee" && (
    <Marquee class="mt-8" repeat={2} duration={45}>
      {CLIENTS.map((c) => (
        <div class="mr-3 flex h-16 shrink-0 items-center gap-3 rounded-2xl bg-soft px-6 text-ink-2">
          <Icon name={c.icon} size={24} class="text-brand" />
          <span class="whitespace-nowrap text-[15px] font-semibold tracking-tight">{c.name}</span>
        </div>
      ))}
    </Marquee>
  )}
  {variant === "grid" && (
    <div class="container-l mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {CLIENTS.map((c) => (
        <div class="flex h-16 items-center gap-3 rounded-2xl bg-soft px-5 text-ink-2">
          <Icon name={c.icon} size={22} class="shrink-0 text-brand" />
          <span class="text-[15px] font-semibold">{c.name}</span>
        </div>
      ))}
    </div>
  )}
</section>

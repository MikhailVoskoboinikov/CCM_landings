---
/*
 * Клиенты — сразу после «О ЦКМ», как просили в ЦКМ.
 * Кыргызстан: реальные клиенты из презентации учебного центра с тем, чему учились.
 * Узбекистан: пока отрасли (нужны логотипы и разрешение компаний). Варианты:
 *  marquee — бегущая строка; grid — сетка.
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import Marquee from "@/components/parts/Marquee.astro";
import { CLIENTS, CLIENTS_KG } from "@/data/about";
import type { Country } from "@/data";

interface Props { variant?: "marquee" | "grid"; country: Country }
const { variant = "marquee", country } = Astro.props;
const named = country.id === "kg" ? CLIENTS_KG : undefined;
const title = named
  ? "[[С кем мы уже работали в Кыргызстане|Можно ли показывать эти названия на сайте, как в презентации?]]"
  : "[[Обучаем сотрудников компаний из разных отраслей|Логотипы клиентов в Узбекистане и разрешение на их показ — сейчас вместо них отрасли]]";
---
<section class="py-12 md:py-16" id="clients">
  <div class="container-l">
    <Rich as="h2" class="text-[22px] font-bold leading-tight md:text-[30px]" text={title} />
  </div>
  {named && variant === "marquee" && (
    <Marquee class="mt-6 md:mt-8" repeat={2} duration={60}>
      {named.map((c) => (
        <div class="mr-3 w-[280px] shrink-0 rounded-2xl bg-soft px-5 py-4 md:w-[340px]">
          <p class="text-[17px] font-bold leading-snug">{c.name}</p>
          <p class="mt-1 text-[14px] leading-snug text-ink-2">{c.text}</p>
        </div>
      ))}
    </Marquee>
  )}
  {named && variant === "grid" && (
    <ul class="container-l mt-6 grid gap-2.5 md:mt-8 md:grid-cols-2 lg:grid-cols-3">
      {named.map((c, i) => (
        <li class="rounded-2xl bg-soft px-5 py-4" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <p class="text-[18px] font-bold leading-snug">{c.name}</p>
          <p class="mt-1 text-[14.5px] leading-snug text-ink-2">{c.text}</p>
        </li>
      ))}
    </ul>
  )}
  {!named && variant === "marquee" && (
    <Marquee class="mt-8" repeat={2} duration={45}>
      {CLIENTS.map((c) => (
        <div class="mr-3 flex h-16 shrink-0 items-center gap-3 rounded-2xl bg-soft px-6 text-ink-2">
          <Icon name={c.icon} size={24} class="text-brand" />
          <span class="whitespace-nowrap text-[15px] font-semibold tracking-tight">{c.name}</span>
        </div>
      ))}
    </Marquee>
  )}
  {!named && variant === "grid" && (
    <div class="container-l mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {CLIENTS.map((c) => (
        <div class="flex min-h-16 items-center gap-3 rounded-2xl bg-soft px-4 py-3 text-ink-2">
          <Icon name={c.icon} size={22} class="shrink-0 text-brand" />
          <span class="text-[14.5px] font-semibold leading-snug">{c.name}</span>
        </div>
      ))}
    </div>
  )}
</section>

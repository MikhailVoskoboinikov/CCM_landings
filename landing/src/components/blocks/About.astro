---
/*
 * О ЦКМ: почему нам доверять. Варианты:
 *  stats — карта учебных центров, счётчики и четыре причины доверять
 *  photo — фото с флагами ЦКМ на всю ширину, текст и цифры поверх светлой части
 *  map   — карта учебных центров, причины доверять и цифры
 *  story — фото инструкторов и история ЦКМ
 */
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import CentersMap from "@/components/parts/CentersMap.astro";
import { CENTERS, STATS, TRUST } from "@/data/about";
import { IMG, type Country } from "@/data";
import { Picture } from "astro:assets";
import flags from "@/assets/ccm-flags.png";

interface Props { variant?: "stats" | "photo" | "map" | "story"; country: Country }
const { variant = "stats", country } = Astro.props;

const intro = "С 2006 года ЦКМ оказывает медицинскую помощь на предприятиях и в удалённых регионах. Практический опыт наших специалистов лежит в основе обучающих курсов.";
const stat = (s: (typeof STATS)[number]) => (s.q ? `[[${new Intl.NumberFormat("ru-RU").format(s.value)}${s.suffix}|${s.q}]]` : "");

---
<section class={`relative overflow-hidden ${variant === "photo" ? "" : "py-14 md:py-28"}`} id="about">
  {variant === "photo" && (
    <div class="relative md:flex md:min-h-[620px] md:items-center lg:min-h-[680px]">
      {/* Фото медленно дрейфует; справа (на телефоне — снизу) растворяется в белом, там текст */}
      <div class="relative h-[300px] overflow-hidden sm:h-[380px] md:absolute md:inset-0 md:h-auto">
        <Picture src={flags} formats={["avif", "webp"]} widths={[640, 1024, 1713]} sizes="100vw" alt="Флаги Центра корпоративной медицины на фоне карты объектов" loading="lazy" class="size-full animate-drift object-cover object-[28%_center] md:object-[20%_center]" />
        <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-b from-transparent to-white md:hidden" />
        <div class="absolute inset-0 hidden bg-[linear-gradient(90deg,transparent_30%,rgba(255,255,255,.85)_55%,#fff_72%)] md:block" />
      </div>
      <div class="container-l relative -mt-6 pb-16 md:mt-0 md:py-24">
        <div class="md:ml-auto md:w-[46%]" data-reveal>
          <h2 class="h-section">Центр корпоративной медицины</h2>
          <p class="lead-text mt-4">С 2006 года ЦКМ оказывает медицинскую помощь там, где до больницы далеко: здравпункты на промышленных объектах, медицинская эвакуация, дистанционные консультации. Этот опыт — основа наших курсов.</p>
          <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8">
            {STATS.map((s) => (
              <div>
                <dt class="text-[36px] font-bold leading-none tracking-tight text-brand md:text-[44px]">
                  {!s.q ? <span data-count={s.value}>0</span> : <Rich text={stat(s)} />}{!s.q && s.suffix}
                </dt>
                <dd class="mt-2 text-[14.5px] leading-snug text-ink-2">{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  )}
  <div class="container-l">
    {variant === "stats" && (
      <>
        <div class="grid items-center gap-8 md:grid-cols-[1.1fr_.9fr] md:gap-12">
          <div data-reveal>
            <h2 class="h-section">Центр корпоративной медицины</h2>
            <p class="lead-text mt-4">{intro}</p>
          </div>
          <div data-reveal><CentersMap country={country} /></div>
        </div>
        <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 md:mt-16 md:grid-cols-4">
          {STATS.map((s, i) => (
            <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <dt class="text-[40px] font-bold leading-none tracking-tight text-brand md:text-[56px]">
                {!s.q ? <span data-count={s.value}>0</span> : <Rich text={stat(s)} />}{!s.q && s.suffix}
              </dt>
              <dd class="mt-3 text-[15px] leading-snug text-ink-2">{s.label}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 grid grid-cols-2 gap-3 md:mt-14 md:gap-4 lg:grid-cols-4">
          {TRUST.map((t, i) => (
            <article class="flex flex-col gap-3 rounded-3xl bg-soft p-4 md:p-5" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-white text-brand"><Icon name={t.icon} size={22} /></span>
              <h3 class="text-[15.5px] font-bold leading-snug md:text-base">{t.title}</h3>
              <p class="text-[14px] leading-snug text-ink-2 md:text-[15px]">{t.text}</p>
            </article>
          ))}
        </div>
      </>
    )}

    {variant === "map" && (
      <div class="grid items-center gap-10 md:grid-cols-[.9fr_1.1fr] md:gap-16">
        <div data-reveal>
          <h2 class="h-section">Центр корпоративной медицины</h2>
          <p class="lead-text mt-4">{intro}</p>
          <ul class="mt-8 grid gap-4">
            {TRUST.slice(0, 3).map((t) => (
              <li class="flex gap-3"><Icon name={t.icon} size={22} class="mt-0.5 shrink-0 text-brand" /><div><b>{t.title}</b><p class="text-[15px] text-ink-2">{t.text}</p></div></li>
            ))}
          </ul>
        </div>
        <div class="relative" data-reveal>
          <CentersMap country={country} />
          <div class="mt-6 grid grid-cols-3 gap-4 text-center">
            <div><p class="text-3xl font-bold text-brand"><span data-count="20">0</span></p><p class="text-sm text-ink-2">лет работы</p></div>
            <div><p class="text-3xl font-bold text-brand"><span data-count="6">0</span></p><p class="text-sm text-ink-2">центров</p></div>
            <div><p class="text-3xl font-bold text-brand"><Rich text="[[12 000+|Сколько человек обучено всего и по странам?]]" /></p><p class="text-sm text-ink-2">обучено</p></div>
          </div>
        </div>
      </div>
    )}

    {variant === "story" && (
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
                <div class="relative" data-reveal>
          <img src={IMG.team} alt="Инструкторы учебного центра с манекеном" loading="lazy" class="aspect-[4/3] w-full rounded-[28px] object-cover" />
          <div class="absolute -bottom-5 right-4 rounded-2xl bg-white px-5 py-4 shadow-xl md:-right-6">
            <p class="text-3xl font-bold text-brand">с 2006</p>
            <p class="text-sm text-ink-2">года на удалённых объектах</p>
          </div>
        </div>
        <div data-reveal>
          <h2 class="h-section">Мы сами оказываем помощь там, где до больницы далеко</h2>
          <p class="lead-text mt-5">{"Центр корпоративной медицины обеспечивает медицинскую помощь на промышленных объектах: здравпункты, медицинская эвакуация, дистанционные консультации. Инструкторы учебного центра учат тому, что делают на работе."}</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex gap-3"><Icon name="Check" class="shrink-0 text-brand" />Учебные центры в Ташкенте, Бишкеке, Астане, Москве, Санкт-Петербурге и Томске</li>
            <li class="flex gap-3"><Icon name="Check" class="shrink-0 text-brand" /><Rich text="Под медицинским сопровождением ЦКМ — [[около 95 000 человек|Можно ли публиковать число сотрудников под сопровождением?]]" /></li>
            <li class="flex gap-3"><Icon name="Check" class="shrink-0 text-brand" />Программы по рекомендациям ERC 2025</li>
          </ul>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  // Счётчики набегают, когда блок появляется на экране
  const fmt = new Intl.NumberFormat("ru-RU");
  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.count);
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1400);
      el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (run(e.target as HTMLElement), io.unobserve(e.target))), { threshold: 0.6 });
  document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => io.observe(el));
</script>

---
import Icon from "@/components/parts/Icon.astro";
import Rich from "@/components/parts/Rich.astro";
import { BLS_UZ_ORGANIZATIONS } from "@/data/bls-uz";
import type { Country, Course } from "@/data";

interface Props { course: Course; country: Country }
const { course, country } = Astro.props;
const content = BLS_UZ_ORGANIZATIONS;
---
<section class="py-12 md:py-16" id="organizations" aria-labelledby="organizations-title">
  <div class="container-l">
    <div class="rounded-[28px] bg-soft p-6 md:p-10" data-reveal>
      <div class="grid items-start gap-7 lg:grid-cols-[1fr_auto] lg:gap-12">
        <div class="max-w-2xl">
          <h2 class="h-section" id="organizations-title">{content.title}</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-ink-2">{content.lead}</p>
        </div>
        <div class="flex flex-col gap-3 lg:pt-1">
          <button data-lead-open={course.id} class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-600">
            {content.cta}<Icon name="ArrowUpRight" size={18} />
          </button>
          <a href={country.phoneHref} class="flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-ink-2 hover:text-brand"><Icon name="Phone" size={17} />{country.phone}</a>
        </div>
      </div>
      <ul class="mt-8 grid gap-5 md:grid-cols-3 md:gap-8">
        {content.items.map((item) => (
          <li class="flex min-w-0 gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white text-brand"><Icon name={item.icon} size={20} /></span>
            <div><h3 class="font-bold">{item.title}</h3><Rich as="p" class="mt-1 text-[15px] leading-relaxed text-ink-2" text={item.text} /></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

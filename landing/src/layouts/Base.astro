---
import "@/styles/global.css";
import "fullpage.js/dist/fullpage.css";
import LeadSheet from "@/components/lead/LeadSheet";
import { COURSE_LIST, type Country, type CourseId } from "@/data";
import { priceText } from "@/lib/price";
import { showMarks } from "@/lib/rich";
import { url } from "@/lib/url";

interface Props {
  title: string;
  description?: string;
  country: Country;
  courseId: CourseId;
  noindex?: boolean;
  /** Режим прокрутки на телефоне — SCROLL в config/blocks.ts */
  scroll?: string;
}
const { title, description = "", country, courseId, noindex, scroll } = Astro.props;
const courses = COURSE_LIST.map((c) => ({ id: c.id, name: c.name }));
const prices = Object.fromEntries(COURSE_LIST.map((c) => [c.id, priceText(c, country)]));
---
<!doctype html>
<html lang="ru" data-snap={scroll}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
  </head>
  <body class="min-h-dvh">
    <div data-landing-content><slot /></div>
    <LeadSheet client:idle country={country} courses={courses} courseId={courseId} prices={prices} />
    {showMarks && <div id="q-tip" class="pointer-events-none fixed z-[100] hidden max-w-72 rounded-xl bg-ink px-3 py-2 text-[13px] leading-snug text-white shadow-xl"></div>}

    <script>
      import { captureAttribution } from "@/lib/attribution";
      import { initMobileFullpage } from "@/lib/mobile-fullpage";
      captureAttribution();
      initMobileFullpage();

      // Появление блоков при прокрутке
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add("is-in"), io.unobserve(e.target))),
        { rootMargin: "0px 0px -8% 0px" },
      );
      const watch = () => document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((el) => io.observe(el));
      watch();
      document.addEventListener("ccm:rendered", watch);

      // Точки доводки для режима прокрутки: верхние секции блоков и подвал, которые сейчас видны.
      // Варианты блоков на стенде и половинки adaptive скрыты — их пропускаем.
      const snapPoints = () => {
        const top = [...document.querySelectorAll<HTMLElement>("section, footer")].filter((s) => !s.parentElement?.closest("section, footer") && s.getClientRects().length);
        document.querySelectorAll("[data-snap-point]").forEach((s) => s.removeAttribute("data-snap-point"));
        top.forEach((s, i) => s.setAttribute("data-snap-point", i < 3 ? "first" : ""));
      };
      snapPoints();
      document.addEventListener("ccm:rendered", snapPoints);
      document.addEventListener("ccm:mode", snapPoints);
      matchMedia("(min-width: 768px)").addEventListener("change", snapPoints);

      // Подсказка к пометкам «уточнить у ЦКМ»
      const tip = document.getElementById("q-tip");
      if (tip) {
        const show = (el: HTMLElement) => {
          if (document.documentElement.classList.contains("hide-marks")) return;
          tip.innerHTML = `<b style="color:#ffe58a">Уточнить у ЦКМ:</b> ${el.dataset.q}`;
          tip.classList.remove("hidden");
          const r = el.getBoundingClientRect();
          const w = tip.offsetWidth, h = tip.offsetHeight;
          const x = Math.min(Math.max(8, r.left), innerWidth - w - 8);
          const y = r.bottom + 8 + h > innerHeight ? r.top - h - 8 : r.bottom + 8;
          tip.style.left = x + "px";
          tip.style.top = y + "px";
        };
        document.addEventListener("mouseover", (e) => {
          const q = (e.target as HTMLElement).closest<HTMLElement>(".q-mark");
          if (q) show(q);
        });
        document.addEventListener("mouseout", (e) => {
          if ((e.target as HTMLElement).closest(".q-mark")) tip.classList.add("hidden");
        });
        document.addEventListener("focusin", (e) => {
          const q = (e.target as HTMLElement).closest<HTMLElement>(".q-mark");
          if (q) show(q);
        });
        addEventListener("scroll", () => tip.classList.add("hidden"), { passive: true });
      }
    </script>
  </body>
</html>
